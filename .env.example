NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=
NEXT_PUBLIC_VALUECOMMERCE_SID=
NEXT_PUBLIC_VALUECOMMERCE_PID=

# 楽天ウェブサービスのアプリID（npm run fetch:rakuten で画像・商品リンクを取得）
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 楽天に登録したアプリケーションURL
RAKUTEN_REFERER=http://localhost:3000
