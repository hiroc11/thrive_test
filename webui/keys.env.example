# このファイルをコピーして「keys.env」という名前で保存し、= の右にAPIキーを貼り付けてください。
# 制作画面の「設定」タブからキーを保存した場合も、このPCの keys.env に書き込まれます。
# keys.env はこのPCだけに置かれ、GitHubには上がりません。

# fal.ai のAPIキー（https://fal.ai/dashboard/keys で発行）
FAL_KEY=

# Aivis Cloud API のAPIキー（Aivis のダッシュボードで発行）
AIVIS_API_KEY=

# Fish Audio のAPIキー（fish.audio の API キーのページで発行）
FISH_API_KEY=
